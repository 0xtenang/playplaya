{
  "name": "trayfarers",
  "version": "1.0.0",
  "private": true,
  "description": "An idle RPG strip with a server-authoritative player market.",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node build.mjs",
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/server.test.mjs test/wallet.test.mjs && node test/sim.mjs 1 777",
    "test:chain": "forge test --offline && node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/chain.e2e.mjs",
    "audit": "node --disable-warning=ExperimentalWarning server/admin.mjs audit"
  }
}
